RewriteRule ^assets/img/c41908f919c6\.jpg$ /assets/img/modelo-3d-vivienda-detalle.jpg [R=301,L]
RewriteRule ^assets/img/deb248287144\.webp$ /assets/img/fachada-balcones-paneles-colores.webp [R=301,L]
