RewriteRule ^assets/img/743868d96144\.svg$ /assets/img/icono-camara-streaming.svg [R=301,L]
# Nombres descriptivos de las imagenes (tanda 02).
RewriteRule ^assets/img/03194119e993\.jpg$ /assets/img/fachada-edificio-paneles-ventanas.jpg [R=301,L]
RewriteRule ^assets/img/202ff2d9f1c3\.webp$ /assets/img/corrosion-junta-panel-metalico.webp [R=301,L]
RewriteRule ^assets/img/400e2d38af86\.webp$ /assets/img/termografia-aerea-edificios.webp [R=301,L]
RewriteRule ^assets/img/44a0b14db536\.webp$ /assets/img/vista-aerea-cubiertas-edificio.webp [R=301,L]
RewriteRule ^assets/img/49f9f67953a5\.jpg$ /assets/img/visita-tecnica-obra-construccion.jpg [R=301,L]
RewriteRule ^assets/img/681e2c6dc7b3\.jpg$ /assets/img/modelo-tridimensional-vivienda.jpg [R=301,L]
RewriteRule ^assets/img/81a6ccf150ca\.jpg$ /assets/img/modelo-tridimensional-vivienda-miniatura.jpg [R=301,L]
RewriteRule ^assets/img/ba090ad46e51\.jpg$ /assets/img/edificio-residencial-inspeccion-precompra.jpg [R=301,L]
RewriteRule ^assets/img/be614a2858ba\.jpeg$ /assets/img/termografia-fachadas-edificio.jpeg [R=301,L]
RewriteRule ^assets/img/d0c0f8082f50\.webp$ /assets/img/vista-aerea-cubiertas-edificio-detalle.webp [R=301,L]
RewriteRule ^assets/img/d5a1bc30307c\.jpg$ /assets/img/fachada-edificio-hormigon.jpg [R=301,L]
RewriteRule ^assets/img/e95629ca101a\.webp$ /assets/img/desprendimiento-revestimiento-fachada.webp [R=301,L]
RewriteRule ^inspeccion-cubiertas-drones/?$ /inspeccion-tecnica-con-drones/ [R=301,L]
RewriteRule ^termografia-edificios/?$ /termografia-con-dron/ [R=301,L]
RewriteRule ^diagnostico-fachadas-edificios/?$ /diagnostico-fachadas/ [R=301,L]
RewriteRule ^inspeccion-edificios-drones/?$ /inspeccion-tecnica-con-drones/ [R=301,L]
RewriteRule ^arquitecto-drones/?$ /ingenieria/ [R=301,L]
RewriteRule ^services/contact_process\.php$ - [L]
RewriteRule ^(?:components|services|tools|docs|var|archive|copia-dronex)(?:/|$) - [R=404,L]
RewriteRule ^(?:error_log|package(?:-lock)?\.json|pnpm-lock\.yaml|README\.md)$ - [R=404,L,NC]
RewriteRule (^|/)\. - [R=404,L]
RewriteRule ^router(?:\.php)?$ - [R=404,L]
RewriteRule ^$ index.php [L]
RewriteCond %{THE_REQUEST} \s/+([a-z0-9-]+)\.php[?\s] [NC]
RewriteRule ^([a-z0-9-]+)\.php$ /$1/ [R=301,L]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([a-z0-9-]+)/$ $1.php [L]
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([a-z0-9-]+)$ /$1/ [R=301,L]
RewriteRule ^ - [R=404,L]
ErrorDocument 404 /404.php
