Options -Indexes -MultiViews
DirectoryIndex index.php
# Keep archived sites private even when they contain their own rewrite rules.
<If "%{REQUEST_URI} =~ m#^/(archive|copia-dronex)(/|$)#">
    Require all denied
</If>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/avif "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>
RewriteEngine On
# Portada unica del dominio oficial; THE_REQUEST evita redirigir el index interno.
RewriteCond %{HTTP_HOST} ^(?:www\.)?eurodronex\.com(?::[0-9]+)?$ [NC]
RewriteCond %{THE_REQUEST} \s/+((?:index|home|inicio)(?:\.(?:php|html?))?)/?(?:[?\s]) [NC]
RewriteRule ^(?:index|home|inicio)(?:\.(?:php|html?))?/?$ https://eurodronex.com/ [R=301,L,NC]

# HTTPS y sin www, conservando ruta y parametros. No afecta al subdominio de pruebas.
RewriteCond %{HTTP_HOST} ^(?:www\.)?eurodronex\.com(?::[0-9]+)?$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^eurodronex\.com$ [NC]
RewriteRule ^ https://eurodronex.com%{REQUEST_URI} [R=301,L]

# Alias de portada tambien en desarrollo, antes de resolver internamente index.php.
RewriteCond %{THE_REQUEST} \s/+((?:index|home|inicio)(?:\.(?:php|html?))?)/?(?:[?\s]) [NC]
RewriteRule ^(?:index|home|inicio)(?:\.(?:php|html?))?/?$ / [R=301,L,NC]
RewriteRule ^assets/img/356d1286436b\.avif$ /assets/img/tecnico-dron-obra.avif [R=301,L]
RewriteRule ^assets/img/84bee8a5b725\.avif$ /assets/img/dron-inspeccion-edificio-construccion.avif [R=301,L]
RewriteRule ^assets/img/40597b370799\.avif$ /assets/img/dron-planos-ingenieria.avif [R=301,L]
# Imagenes descriptivas: revision completa.
RewriteRule ^assets/img/0219f953b2b0\.jpg$ /assets/img/dron-en-vuelo-sobre-bosque.jpg [R=301,L]
RewriteRule ^assets/img/0fe62ec8d6f2\.png$ /assets/img/humedades-revestimiento-fachada.png [R=301,L]
RewriteRule ^assets/img/132de87c2cd1\.webp$ /assets/img/inspeccion-cubierta-tejas.webp [R=301,L]
RewriteRule ^assets/img/1bfc5bb4d2e4\.png$ /assets/img/logo-eurodronex-fondo-oscuro.png [R=301,L]
