RewriteRule ^assets/img/7e29736d353d\.jpg$ /assets/img/fachada-paneles-blanco-negro.jpg [R=301,L]
RewriteRule ^assets/img/7f8281d703b4\.webp$ /assets/img/vivienda-cartel-venta.webp [R=301,L]
RewriteRule ^assets/img/8fe34ceb1c69\.webp$ /assets/img/fisuras-pavimento-cubierta.webp [R=301,L]
RewriteRule ^assets/img/9faa72f9dcc5\.webp$ /assets/img/fachada-balcones-blanco-negro.webp [R=301,L]
RewriteRule ^assets/img/a79e86a34e68\.jpg$ /assets/img/fachada-hormigon-cielo.jpg [R=301,L]
RewriteRule ^assets/img/b9fbea1c0e97\.webp$ /assets/img/modelo-topografico-terreno.webp [R=301,L]
RewriteRule ^assets/img/bc9f26066541\.jpg$ /assets/img/modelo-3d-vivienda-perspectiva.jpg [R=301,L]
